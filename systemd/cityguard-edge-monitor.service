[Unit]
Description=CityGuard Edge Monitor dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cityguard
Group=cityguard
WorkingDirectory=/opt/cityguard-edge-monitor/server
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/cityguard-edge-monitor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8090
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
