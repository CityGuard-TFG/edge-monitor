[Unit]
Description=CityGuard Edge Monitor dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cityguard
Group=cityguard
WorkingDirectory=/opt/cityguard-edge-monitor/server
Environment=PYTHONUNBUFFERED=1
# Best-effort: checks GitHub for a newer release and updates the checkout in
# place before starting. The leading '-' means a failure here never blocks
# the unit -- the script itself is also written to always exit 0.
ExecStartPre=-/opt/cityguard-edge-monitor/scripts/check-update.sh
ExecStart=/opt/cityguard-edge-monitor/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=5

# Binds port 80 as the unprivileged `cityguard` user rather than running the
# service as root -- CAP_NET_BIND_SERVICE is the one capability that matters
# here, granted via systemd rather than a setuid/setcap binary.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true makes /home fully INACCESSIBLE (mode 000), not merely an
# empty tmpfs -- ReadWritePaths can't punch a hole through a parent that
# can't even be traversed. ProtectHome=read-only keeps /home listable (and
# every other user's home read-only) while letting ReadWritePaths carve out
# a real read-write exception for cityguard's own home, which git/pip/npm
# all need to write cache/config into during the ExecStartPre update check.
# Verified against the real sandbox with systemd-run before relying on it.
ProtectHome=read-only
ReadWritePaths=/opt/cityguard-edge-monitor /home/cityguard

[Install]
WantedBy=multi-user.target
